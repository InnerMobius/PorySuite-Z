# ── Game repos (not part of the app) ──
/pokefirered/

# ── Porymap build artefacts (installer clones/builds these locally) ──
/porymap_src/
/porymap/
/qt_sdk/

# ── Python runtime ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
cleanenv/
_venv_off/

# ── IDE / editor ──
.idea/
.vscode/
.cursor/
.claude/
*.swp
*~
*.autosave
Thumbs.db
.DS_Store

# ── Logs ──
crashlogs/
*.log
# rotated log files (sound_editor.log.1 etc.)
*.log.[0-9]*

# ── Cache (working files for open projects) ──
cache/

# ── User-specific runtime data ──
projects.json
settings.ini
data/
core/data/plugins/
core/data/projects.json
core/data/toolchain/

# ── Test audio artefacts (generated by playback tests) ──
tests/*.wav

# ── Auto-updater staging / transaction state ──
_update_staging/
_update_backup/
_update_preserved/
_apply_update.bat
_recover_update.bat
_update_journal.json
_update_phase.txt
_update_notices.*
_update_lock
_installed_manifest.json

# ── Build / distribution ──
build/
dist/
*.egg-info/

# ── Release notes (live on the GitHub Releases page, not in the source tree) ──
docs/RELEASE_v*.md

# ── Dev-only docs: plans, roadmaps, changelogs, bug tracking, handoffs ──
# These stay on disk for development but aren't shipped with the app. Only
# user-facing docs (READMEs, guides, troubleshooting, screenshots) are tracked.
docs/*_PLAN.md
docs/*_ROADMAP.md
docs/*_FACTS.md
docs/*_REPORT.md
docs/*_LOG.md
docs/*_AUDIT.md
# Internal assessments of PorySuite against other tools. They quote source-read
# behaviour of third-party programs that was never actually run here, which would
# read as a public critique of somebody else's project.
docs/*_ASSESSMENT.md
docs/HANDOFF.md
docs/*_HANDOFF.md
docs/AGENTS.md
docs/BUGS.md
docs/CHANGELOG.md
docs/CLAUDECONTEXT.md
# PRIVATE development records and their archives. The two lines above cover the
# working files by name; these cover every archive / split variant as well
# (docs/BUGS_ARCHIVE.md, docs/CHANGELOG_ARCHIVE_2026-04.md, …). Without them an
# archive file would be TRACKED and would publish six months of private notes
# on the next commit — verified in a throwaway repo on 2026-10-29.
# NOTE: this is PorySuite's OWN docs/ only. The FireRed game project keeps its
# own, separately tracked docs/BUGS.md and CHANGELOG.md in pokefirered/ — those
# are its business and must not be touched.
docs/BUGS*.md
docs/CHANGELOG*.md
docs/DATAFLOW.md
docs/renameplan.md
docs/SOUND_ENGINE_DEBUG_LOG.md
docs/RELEASING.md
eventide/docs/CLAUDECONTEXT.md
eventide/docs/eventide_whitelist.md
# Names from the maintainer's own game that must never appear in PorySuite. Read by
# tests/test_eventide_authoring.py; kept private so the list itself does not leak them.
docs/PRIVATE_PROJECT_NAMES.txt

# Stray local artifacts that don't belong in the repo
/titlescreen.pal
