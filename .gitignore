# ── Game repos (not part of the app) ──
/pokefirered/

# ── Porymap build artefacts (installer clones/builds these locally) ──
/porymap_src/
/porymap/
/qt_sdk/

# ── Python runtime ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
cleanenv/
_venv_off/

# ── IDE / editor ──
.idea/
.vscode/
.cursor/
.claude/
*.swp
*~
*.autosave
Thumbs.db
.DS_Store

# ── Logs ──
crashlogs/
*.log

# ── Cache (working files for open projects) ──
cache/

# ── User-specific runtime data ──
projects.json
settings.ini
data/
core/data/plugins/
core/data/projects.json
core/data/toolchain/

# ── Test audio artefacts (generated by playback tests) ──
tests/*.wav

# ── Auto-updater staging ──
_update_staging/
_apply_update.bat

# ── Build / distribution ──
build/
dist/
*.egg-info/

# ── Release notes (live on the GitHub Releases page, not in the source tree) ──
docs/RELEASE_v*.md

# ── Dev-only docs: plans, roadmaps, changelogs, bug tracking, handoffs ──
# These stay on disk for development but aren't shipped with the app. Only
# user-facing docs (READMEs, guides, troubleshooting, screenshots) are tracked.
docs/*_PLAN.md
docs/*_ROADMAP.md
docs/*_FACTS.md
docs/*_REPORT.md
docs/*_LOG.md
docs/*_AUDIT.md
docs/HANDOFF.md
docs/AGENTS.md
docs/BUGS.md
docs/CHANGELOG.md
docs/CLAUDECONTEXT.md
docs/DATAFLOW.md
docs/renameplan.md
docs/SOUND_ENGINE_DEBUG_LOG.md
docs/RELEASING.md
eventide/docs/CLAUDECONTEXT.md
eventide/docs/eventide_whitelist.md

# Stray local artifacts that don't belong in the repo
/titlescreen.pal
